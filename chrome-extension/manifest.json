{
  "manifest_version": 3,
  "name": "Maina — Discord Rich Presence",
  "version": "1.0.0",
  "description": "Seamlessly broadcast your active high-fidelity stream on Maina to your Discord Rich Presence activity status.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Maina Discord Presence"
  }
}
